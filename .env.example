# Copy to .env (never commit .env).

# Required for answer generation (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: override the Groq model (default: openai/gpt-oss-20b)
GROQ_MODEL=

# Retrieval backend: "local" (default; reads corpus/chunks.jsonl, no database) or "db" (Supabase + pgvector)
AEGIS_BACKEND=local
# Only for AEGIS_BACKEND=db: Postgres connection string from Supabase (Project Settings -> Database)
DATABASE_URL=

# Optional
AEGIS_CORPUS=corpus/chunks.jsonl
AEGIS_WARMUP=1
